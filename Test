private void mockValidDispatcherAgent(String id) {
    when(agent.getId()).thenReturn(id);
    when(agent.getConfiguration()).thenReturn(agentConfig);
    when(agentConfig.getSerializationType()).thenReturn("flush");
    when(agentConfig.getTransportURI()).thenReturn("http://localhost:8080/dispatcher/invalidate.cache");
    when(agentConfig.getProperties()).thenReturn(properties);
    when(properties.get(
            eq(AgentConfig.PROTOCOL_HTTP_HEADERS),
            any(String[].class)))
            .thenReturn(new String[]{"CQ-Action: {action}"});
    when(agent.isEnabled()).thenReturn(true);
}
