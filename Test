function syncModelPath(dialog, mode) {
    var automaticModel = dialog.find("[name='./modelPath']");
    var selectedModel;

    if (mode === "manual") {
        selectedModel = dialog.find("[name='./manualModelPath']").val();
    } else if (mode === "curated") {
        selectedModel = dialog.find("[name='./curatedModelPath']").val();
    } else {
        return;
    }

    if (selectedModel && automaticModel.val() !== selectedModel) {
        automaticModel.val(selectedModel);
        automaticModel.trigger("foundation-field-change");
    }
}
