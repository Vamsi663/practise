document.querySelectorAll(
    ".cmp-extended-cf-list-multi-asterisk"
).forEach(function (component) {

    var fragments = component.querySelectorAll(
        ".cmp-contentfragment"
    );

    fragments.forEach(function (fragment, index) {

        var paragraph = fragment.querySelector(
            ".cmp-contentfragment__element-value p"
        );

        if (paragraph) {
            paragraph.setAttribute(
                "data-asterisks",
                "*".repeat(index + 1)
            );
        }
    });
});

&.cmp-extended-cf-list-multi-asterisk {
    .cmp-contentfragment__element-value p::before {
        content: attr(data-asterisks);
        margin-right: 4px;
        vertical-align: super;
        font-size: 0.8em;
        color: var(--Button-Color-Background---Primary-Default);
    }
}
