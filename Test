package com.barclays.bcuspublic.core.models;

import com.day.cq.replication.Agent;
import com.day.cq.replication.AgentManager;
import org.apache.sling.api.resource.Resource;
import org.apache.sling.models.annotations.DefaultInjectionStrategy;
import org.apache.sling.models.annotations.Model;
import org.apache.sling.models.annotations.injectorspecific.OSGiService;
import org.apache.sling.models.annotations.injectorspecific.ValueMapValue;

import java.util.Collections;
import java.util.List;
import java.util.Locale;
import java.util.stream.Collectors;

@Model(
        adaptables = Resource.class,
        defaultInjectionStrategy = DefaultInjectionStrategy.OPTIONAL
)
public class DispatcherAgentModel {

    @ValueMapValue
    private String dispatcherType;

    @OSGiService
    private AgentManager agentManager;

    public List<Agent> getAgents() {

        if (dispatcherType == null || agentManager == null) {
            return Collections.emptyList();
        }

        String prefix = dispatcherType.toLowerCase(Locale.ROOT);

        return agentManager.getAgents()
                .values()
                .stream()
                .filter(Agent::isEnabled)
                .filter(agent -> agent.getId() != null)
                .filter(agent ->
                        agent.getId()
                                .toLowerCase(Locale.ROOT)
                                .startsWith(prefix))
                .collect(Collectors.toList());
    }
}
