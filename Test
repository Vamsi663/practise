&.cmp-extended-cf-list-single-asterisk,
&.cmp-extended-cf-list-multi-asterisk {
    @include first-element-indicator {
        font-weight: bold;
        font-size: 1em;
        color: inherit;
        margin-right: 0;
        vertical-align: baseline;
    }
}

&.cmp-extended-cf-list-single-asterisk {
    .cmp-contentfragment__element:first-child
    .cmp-contentfragment__element-value::before {
        content: "\002A";
    }
}

&.cmp-extended-cf-list-multi-asterisk {
    .cmp-contentfragment__element:first-child
    .cmp-contentfragment__element-value::before {
        content: attr(data-asterisks);
    }
}
