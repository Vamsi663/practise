var registry = $(window).adaptTo("foundation-registry");

registry.register("foundation.validation.validator", {
    selector: "foundation-autocomplete[name='./curatedListPath']",

    validate: function (el) {
        var path = el.value;

        console.log("CURATED VALIDATOR CALLED:", path);

        if (!path) {
            return;
        }

        var valid = false;

        $.ajax({
            url: path + "/jcr:content/data.json",
            type: "GET",
            dataType: "json",
            async: false,

            success: function (data) {
                console.log("CF DATA:", data);
                valid = data && !!data["cq:model"];
            },

            error: function () {
                console.log("Not a Content Fragment:", path);
                valid = false;
            }
        });

        if (!valid) {
            return "Please select a valid Content Fragment.";
        }
    }
});
