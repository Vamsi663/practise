private AgentFilter getAgentFilter(String pageName) {

        if (AUTHOR_PAGE.equals(pageName)) {

            return agent ->

                    agent != null

                    && agent.getId() != null

                    && agent.getId().startsWith("author");

        }

        if (PUBLISHER_PAGE.equals(pageName)) {

            return agent ->

                    agent != null

                    && agent.getId() != null

                    && agent.getId().startsWith("publisher");

        }

        return null;

    
