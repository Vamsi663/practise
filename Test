$(document).on(
    "change",
    "coral-radio[name='./selectionMode']",
    function () {
        var dialog = $(this).closest("coral-dialog");

        updateFields(dialog);

        var activeModelPath = getActiveModelPath(dialog);
        var coreModelField = dialog.find("[name='./modelPath']");

        console.log("SELECTION MODE:", this.value);
        console.log("ACTIVE MODEL PATH:", activeModelPath);
        console.log("CORE MODEL BEFORE:", coreModelField.val());
        console.log("ACTIVE MODEL:", activeModelPath);
    }
);
