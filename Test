private Collection<DAMContentFragment> getCuratedItems() {
    List<DAMContentFragment> items = new ArrayList<>();

    if (curatedListPath == null || curatedListPath.trim().isEmpty()) {
        return items;
    }

    Resource curatedResource =
            resourceResolver.getResource(curatedListPath);

    if (curatedResource == null) {
        return items;
    }

    ContentFragment curatedFragment =
            curatedResource.adaptTo(ContentFragment.class);

    if (curatedFragment == null) {
        return items;
    }

    ContentElement references =
            curatedFragment.getElement("selectedContentFragments");

    if (references == null || references.getValue() == null) {
        return items;
    }

    String[] paths =
            references.getValue().getValue(String[].class);

    if (paths == null) {
        return items;
    }

    for (String path : paths) {
        Resource resource = resourceResolver.getResource(path);

        if (resource == null) {
            continue;
        }

        ContentFragment fragment =
                resource.adaptTo(ContentFragment.class);

        if (fragment != null) {
            items.add(new DAMContentFragmentWrapper(fragment));
        }
    }

    return items;
}
