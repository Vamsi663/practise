<selectionMode
    jcr:primaryType="nt:unstructured"
    sling:resourceType="granite/ui/components/coral/foundation/form/radiogroup"
    fieldLabel="Selection Mode"
    name="./selectionMode"
    granite:class="cq-dialog-radio-showhide">

    <granite:data
        jcr:primaryType="nt:unstructured"
        cq-dialog-showhide-target=".selection-mode-target"/>

    <items jcr:primaryType="nt:unstructured">

        <automatic
            jcr:primaryType="nt:unstructured"
            text="Automatic (Query Based)"
            value="automatic"
            checked="{Boolean}true"/>

        <manual
            jcr:primaryType="nt:unstructured"
            text="Manual Selection"
            value="manual"/>

        <curated
            jcr:primaryType="nt:unstructured"
            text="Curated List"
            value="curated"/>

    </items>

</selectionMode>


@Model(
    adaptables = SlingHttpServletRequest.class,
    adapters = ContentFragmentList.class,
    resourceType = ExtendedContentFragmentListImpl.RESOURCE_TYPE,
    defaultInjectionStrategy = DefaultInjectionStrategy.OPTIONAL
)
public class ExtendedContentFragmentListImpl implements ContentFragmentList {

    public static final String RESOURCE_TYPE =
            "barclaysuscb/components/contentfragmentlistextended";

    @Self
    @Via(type = ResourceSuperType.class)
    private ContentFragmentList delegate;

    @ValueMapValue
    private String selectionMode;

    @ValueMapValue
    private String[] manualFragmentPaths;

    @ValueMapValue
    private String curatedListPath;

    @Override
    public Collection<ContentFragmentListItem> getListItems() {
        if ("manual".equals(selectionMode)) {
            return getManualItems();
        }

        if ("curated".equals(selectionMode)) {
            return getCuratedItems();
        }

        return delegate.getListItems();
    }
}
