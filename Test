package com.barclays.uscb.core.models;

import com.adobe.cq.dam.cfm.ContentElement;
import com.adobe.cq.dam.cfm.FragmentData;
import com.adobe.cq.wcm.core.components.models.contentfragment.DAMContentFragment.DAMContentElement;
import org.jetbrains.annotations.NotNull;
import org.jetbrains.annotations.Nullable;

public class DAMContentElementWrapper implements DAMContentElement {

    private final ContentElement contentElement;

    public DAMContentElementWrapper(ContentElement contentElement) {
        this.contentElement = contentElement;
    }

    private FragmentData getData() {
        return contentElement.getValue();
    }

    @Override
    public @NotNull String getName() {
        return contentElement.getName();
    }

    @Override
    public @Nullable String getTitle() {
        return contentElement.getTitle();
    }

    @Override
    public @Nullable Object getValue() {
        FragmentData data = getData();
        return data != null ? data.getValue() : null;
    }

    @Override
    public @Nullable <T> T getValue(Class<T> type) {
        FragmentData data = getData();
        return data != null ? data.getValue(type) : null;
    }

    @Override
    public @NotNull String getDataType() {
        FragmentData data = getData();

        return data != null && data.getDataType() != null
                ? data.getDataType().getTypeString()
                : "";
    }

    @Override
    public @NotNull String getExportedType() {
        FragmentData data = getData();

        if (data == null) {
            return "";
        }

        String contentType = data.getContentType();

        return contentType != null
                ? contentType
                : getDataType();
    }

    @Override
    public boolean isMultiValue() {
        FragmentData data = getData();

        return data != null
                && data.getDataType() != null
                && data.getDataType().isMultiValue();
    }

    @Override
    public boolean isMultiLine() {
        FragmentData data = getData();

        return data != null
                && data.getContentType() != null
                && data.getContentType().startsWith("text/")
                && !isMultiValue();
    }

    @Override
    public @Nullable String getHtml() {
        FragmentData data = getData();

        if (data == null || !isMultiLine()) {
            return null;
        }

        String[] values = data.getValue(String[].class);

        if (values != null) {
            return String.join(", ", values);
        }

        return data.getValue(String.class);
    }
}
