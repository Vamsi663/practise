(function ($, document) {
    "use strict";

    function updateFields(dialog) {

        var mode = dialog
            .find("input[name='./selectionMode']:checked")
            .val();

        // Default for existing components where selectionMode isn't stored yet
        if (!mode) {
            mode = "automatic";
        }

        dialog.find(".cf-mode-fields").hide();

        if (mode === "automatic") {
            dialog.find(".cf-automatic-fields").show();
        } else if (mode === "manual") {
            dialog.find(".cf-manual-fields").show();
        } else if (mode === "curated") {
            dialog.find(".cf-curated-fields").show();
        }
    }

    $(document).on("foundation-contentloaded", function (e) {
        var dialog = $(e.target).closest("coral-dialog");

        if (dialog.length) {
            updateFields(dialog);
        }
    });

    $(document).on(
        "change",
        "input[name='./selectionMode']",
        function () {
            updateFields($(this).closest("coral-dialog"));
        }
    );

})(Granite.$, document);
